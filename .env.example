# ---------------------------------------------------------------------------
# Saakshya environment file. Copy to .env and fill in your own values.
# NEVER commit .env. No real survivor data belongs in this project.
# ---------------------------------------------------------------------------

# --- LLM (provider-agnostic) -------------------------------------------------
# one of: google | openai | anthropic
LLM_PROVIDER=google
# Leave blank to use the provider default:
#   google -> gemini-2.5-flash, openai -> gpt-4o-mini, anthropic -> claude-3-5-sonnet-latest
LLM_MODEL=
LLM_TEMPERATURE=0.2
# Set to false to force the deterministic offline pipeline (same as demo brain)
LLM_ENABLED=true

# Google Gemini (free tier: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Optional providers (only needed if LLM_PROVIDER is openai / anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Cloudinary --------------------------------------------------------------
# Easiest: paste the single CLOUDINARY_URL from the Cloudinary dashboard.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Leave it empty until you have real credentials - the app then uses the offline
# mock backend (with a visible warning) instead of failing.
CLOUDINARY_URL=
# ...or set the three parts separately (used if CLOUDINARY_URL is empty)
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# true -> no network calls; assets are stored in ./data/mock_cloudinary
# Use this to run the whole demo offline / during automated tests.
USE_MOCK_CLOUDINARY=false

# Set to true only after enabling the "OCR" add-on in your Cloudinary account.
# false -> the app skips the add-on and goes straight to the LLM fallback.
CLOUDINARY_OCR_ENABLED=false

# --- App behaviour -----------------------------------------------------------
# true -> skip the LLM entirely and use canned deterministic output
DEMO_MODE=false
DB_PATH=data/saakshya.db
# Where mock assets / generated PDFs are written (defaults are fine)
MOCK_STORAGE_DIR=data/mock_cloudinary
EXPORTS_DIR=data/exports

# LangGraph checkpointer: memory | sqlite
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_PATH=data/checkpoints.db

# Signed share link lifetime, in hours (UI offers 1h / 24h / 7d)
SHARE_DEFAULT_HOURS=24

# --- LangSmith tracing (optional) -------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=saakshya

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
